+pub(crate) fn type_lacks_copy_constructor(ty: &Type) -> bool {
+    // In future we may wish to look this up in KNOWN_TYPES.
+    match ty {
+        Type::Path(typ) => {
+            let tn = TypeName::from_type_path(typ);
+            tn.to_cpp_name().starts_with("std::unique_ptr")
+        }
+        _ => false,
+    }
+}
