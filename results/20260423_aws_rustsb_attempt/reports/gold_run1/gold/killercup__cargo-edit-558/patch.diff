new file mode 100644
--- /dev/null
+++ b/src/util.rs
@@ -0,0 +1,10 @@
+pub use termcolor::ColorChoice;
+
+/// Whether to color logged output
+pub fn colorize_stderr() -> ColorChoice {
+    if concolor_control::get(concolor_control::Stream::Stderr).color() {
+        ColorChoice::Always
+    } else {
+        ColorChoice::Never
+    }
+}
